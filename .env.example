# Copy this file to .env and fill in your keys. Never commit .env.

# Qloo hackathon key (arrives by email). Leave empty to use demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Free Gemini key from https://aistudio.google.com/apikey
# Leave empty to run with simple rules instead of an LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
